{
  "id": "kuma-module-cahier-texte",
  "name": "KUMA Module — Cahier de Texte (Côte d'Ivoire) v1.0.0",
  "version": "1.0.0",
  "apiVersion": "v1",
  "country": "CI",
  "countryLabel": "Côte d'Ivoire",
  "description": "Cahier de texte numérique avec suivi pédagogique par enseignant, validation par la direction, et consultation par les parents. Module autonome.",
  "mountPath": "/api/v1/modules/lessons",
  "entry": {
    "server": "server/lessonModule.ts",
    "standalone": "server/standalone/index.ts",
    "frontend": "frontend/LessonPlanTracker.tsx",
    "schema": "server/schema.sql"
  },
  "requires": {
    "hono": ">=4.0.0",
    "d1Binding": "DB",
    "authContextVars": [
      "tenantId",
      "jwtPayload"
    ]
  },
  "permissions": {
    "admin": [
      "read",
      "write",
      "delete"
    ],
    "teacher": [
      "read",
      "write",
      "validate"
    ],
    "student": [
      "read_own"
    ],
    "parent": [
      "read_own"
    ]
  },
  "capabilities": {
    "hasBridgeMode": true,
    "supportsLessonPlans": true,
    "supportsParentView": true,
    "supportsValidation": true,
    "standaloneSupported": true
  },
  "author": "perissosdigitalsolution-oss",
  "license": "MIT",
  "repository": "https://github.com/perissosdigitalsolution-oss/kuma-module-cahier-texte"
}